# Copia este archivo a .env y rellena solo lo que vayas a usar.

# --- Guion con LLM (opcional; sin clave se usa el generador de plantillas) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Voz Azure (opcional; edge-tts funciona sin clave) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- Música (Jamendo es el catálogo principal; la clave es gratuita) ---
JAMENDO_CLIENT_ID=

# --- Imágenes de respaldo (opcionales: Wikimedia y Foodish no necesitan clave) ---
PEXELS_API_KEY=
